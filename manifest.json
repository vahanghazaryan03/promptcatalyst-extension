{
  "manifest_version": 3,
  "name": "Prompt Catalyst",
  "description": "Your ultimate companion for creating image prompts for AI image generators such as Midjourney, Flux, Stable Diffusion, DALLE.",
  "version": "1.9.3",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://promptcatalyst.ai/*",
    "https://urvfnsimzrfxwhisydpt.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "previews/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://im.runware.ai/ https://cdn.midjourney.com/"
  }
}
